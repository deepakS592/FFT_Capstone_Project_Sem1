NODE_ENV=development
PORT=4000
# Use the Neon connection string or a local PostgreSQL URL. Keep this value private.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate a new random value at least 32 characters long.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_MAX_AGE_HOURS=12
# Used only by the development seed. Never expose a real account password.
SEED_DEMO_PASSWORD=replace-with-a-long-local-only-password
# Optional: set only for a local PostgreSQL server without TLS.
# PGSSLMODE=disable
# Production only: exact public URL, for additional Origin validation.
# APP_ORIGIN=https://your-service.onrender.com
